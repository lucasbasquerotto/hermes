# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# LLM Provider
# OPENCODE_GO_API_KEY is used for the opencode-go provider (DeepSeek, etc.)
OPENCODE_GO_API_KEY=

# GitHub App credentials - required for Hermes to manage repos
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=

# Google API key (optional - used for some provider backends)
GOOGLE_API_KEY=

# S3-compatible backup (agnostic: Backblaze, AWS, Minio, etc.)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Dashboard
HERMES_DASHBOARD=1

# Hindsight memory service
HINDSIGHT_API_URL=http://hermes-hindsight:8888
HINDSIGHT_API_LLM_PROVIDER=
HINDSIGHT_API_LLM_MODEL=
HINDSIGHT_API_LLM_BASE_URL=
HINDSIGHT_API_LLM_API_KEY=
