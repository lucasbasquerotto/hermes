# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# LLM Provider
# OPENCODE_GO_API_KEY is used for the opencode-go provider (DeepSeek, etc.)
OPENCODE_GO_API_KEY=

# GitHub App credentials - required for Hermes to manage repos
# The GitHub App must be organization-scoped/restricted to your org.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=

# Google API key (optional - used for some provider backends)
GOOGLE_API_KEY=

# S3-compatible backup (agnostic: Backblaze, AWS, Minio, etc.)
# Generate S3-compatible keys from your provider's dashboard.
# For Backblaze: App Keys -> New Key -> dedicated key (all non-master keys work with S3 API)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Dashboard
HERMES_DASHBOARD=1
