# HashiCorp Vault - root token and unseal key
# NOTE: Vault must already be initialized and unsealed before these are used.
# These allow Hermes to read secrets from Vault at runtime.
# The Vault container is started with dev mode by default (no token needed for dev).
# For production, set up Vault manually, then populate these values.
VAULT_ROOT_TOKEN=
VAULT_SINGLE_KEY=
